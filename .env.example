# EcoEnergy - Variables de Entorno
# Copie este archivo como .env y configure según su entorno

# Configuración básica Django
SECRET_KEY=django-insecure-tf*&rw==iz2wj8$o4k6m+*ag@^a60lnce8g&o6gha)5lz@a-5_
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Configuración de Base de Datos
# Por defecto se utiliza SQLite para máxima portabilidad en laboratorios y despliegues en Ubuntu EC2
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Para conectar a AWS RDS (PostgreSQL o MySQL), descomente y configure:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecoenergy_db
# DB_USER=postgres
# DB_PASSWORD=tu_password_rds
# DB_HOST=tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432

# Configuración de Email (SMTP / hMailServer)
# Por defecto utiliza la consola de Django para pruebas locales
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@ecoenergy.cl

# Configuración de WhatsApp Bot (CallMeBot API para demostración 2FA)
# 1. Enviar 'I allow callmebot to send me messages' a +34 644 49 19 84 por WhatsApp
# 2. Copiar la APIKey recibida y su número (ej: +569XXXXXXXX):
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=
